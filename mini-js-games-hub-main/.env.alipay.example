# 支付宝应用基础配置
ALIPAY_APP_ID=your_app_id
ALIPAY_PRIVATE_KEY_PATH=/absolute/path/to/your-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=/absolute/path/to/your-alipay-public-key.pem

# 本地或线上地址
SITE_BASE_URL=http://127.0.0.1:4173/mini-js-games-hub-main
SERVER_BASE_URL=http://127.0.0.1:8788
ALIPAY_PAY_PORT=8788

# 可选，不填则使用默认支付宝网关
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 可选，不填则自动拼接
ALIPAY_NOTIFY_URL=http://127.0.0.1:8788/pay-api/alipay/notify
ALIPAY_RETURN_URL=http://127.0.0.1:4173/mini-js-games-hub-main/payment-success.html
ALIPAY_QUIT_URL=http://127.0.0.1:4173/mini-js-games-hub-main/index.html
